{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevKit",
  "version": "4.3.0",
  "identifier": "com.northstarcoding.devkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "DevKit",
        "url": "index.html?window=widget",
        "width": 500,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "control-center",
        "title": "DevKit Control Center",
        "url": "index.html?window=control-center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../core": "core",
      "../../tools": "tools",
      "../../VERSION": "VERSION"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQUMyOEEwMTg4QTNDRDkKUldUWlBJb1lvQ2lzcjNJeXd5bmd3SDFGaEJISjFONVlTZUdNczl3bkY5QjFsTmoxY3ZKczB2YzUK",
      "endpoints": [
        "https://github.com/st3adyp1ck/northstar-devkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
