<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="Northstar DevKit"
    Width="1180" Height="760" MinWidth="980" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="CanResize"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!--
        Northstar DevKit desktop shell. Parsed by DevKit-GUI.ps1 via
        XamlReader - no x:Class, no compiled resources. The theme
        (gui/Theme.xaml) is parsed separately and assigned to the
        Application's resources BEFORE this window is loaded: loose XAML
        cannot reference external dictionaries without pack URIs, and only
        Application resources make the theme's keyless (implicit) styles -
        ScrollBar, ToolTip, CheckBox - reach template-generated elements
        (Window.Resources never does). Keyed StaticResource lookups below
        walk up to the app resources at parse time. All dynamic content
        (nav items, tool cards, dialogs) is built by the code-behind
        against the x:Name handles here.
    -->

    <Border x:Name="RootBorder" Style="{StaticResource RootWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ==================== TITLE BAR ==================== -->
            <Border x:Name="TitleBar" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="TitleLogoImage" Width="24" Height="24" Margin="14,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <Run Text="NORTHSTAR" FontWeight="SemiBold" Foreground="{StaticResource BrushMetalGradient}"/>
                        <Run Text=" DEVKIT" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentBlue}"/>
                    </TextBlock>

                    <TextBlock Grid.Column="2" x:Name="TitleVersionText" Style="{StaticResource StatusText}" Margin="10,0,0,0"/>

                    <Border Grid.Column="3" x:Name="AdminBadge" Style="{StaticResource CautionChip}"
                            Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CautionChipText}" Text="ADMIN"/>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button x:Name="BtnWidget" Style="{StaticResource ChromeButton}" Content="&#xE7F4;" ToolTip="Companion widget - metrics, node processes, MCP status (keeps running in the tray)"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimize"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximize"/>
                        <Button x:Name="BtnClose" Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" ToolTip="Close"/>
                    </StackPanel>
                    <Border Grid.Column="5" Width="8"/>
                </Grid>
            </Border>

            <!-- ==================== BODY ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left navigation -->
                <Border Background="{StaticResource BrushNavBg}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="12,12,12,4">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="32"/>
                            <TextBlock x:Name="SearchWatermark" Style="{StaticResource SearchWatermark}" Text="Search tools...  (Ctrl+F)"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NavList" Margin="0,4,0,12"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,1" Padding="28,20,28,16">
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}" Text="Northstar DevKit"/>
                            <Border Width="48" Height="3" HorizontalAlignment="Left" Margin="0,9,0,0"
                                    Background="{StaticResource BrushAccentGradient}" CornerRadius="2"/>
                            <TextBlock x:Name="PageDescription" Style="{StaticResource PageDescriptionText}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ContentPanel" Margin="28,18,28,18"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==================== STATUS BAR ==================== -->
            <Border Grid.Row="2" Background="{StaticResource BrushStatusBg}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StatusProjectButton" Style="{StaticResource GhostButton}" BorderThickness="0" Padding="4,2" FontSize="11.5"
                            ToolTip="Change the Active Project">
                        <Button.Content>
                            <TextBlock x:Name="StatusProjectText" FontSize="11.5"/>
                        </Button.Content>
                    </Button>

                    <TextBlock Grid.Column="2" x:Name="StatusTerminalText" Style="{StaticResource StatusText}" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="3" x:Name="StatusVersionText" Style="{StaticResource StatusText}" HorizontalAlignment="Right" Margin="14,0,0,0"/>
                    <ResizeGrip Grid.Column="4" Style="{StaticResource ResizeGripDots}" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- ==================== RESIZE THUMBS ====================
                 WindowStyle=None + AllowsTransparency removes the OS resize
                 handles (the ResizeGrip above is decorative only), so these
                 transparent edge/corner strips start a resize instead: the
                 code-behind turns their MouseLeftButtonDown into a
                 WM_NCLBUTTONDOWN with the HT* code carried in Tag. -->
            <Border x:Name="ResizeTop" Grid.RowSpan="3" Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" Tag="12"/>
            <Border x:Name="ResizeBottom" Grid.RowSpan="3" Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Tag="15"/>
            <Border x:Name="ResizeLeft" Grid.RowSpan="3" Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="10"/>
            <Border x:Name="ResizeRight" Grid.RowSpan="3" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="11"/>
            <Border x:Name="ResizeTopLeft" Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Tag="13"/>
            <Border x:Name="ResizeTopRight" Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Tag="14"/>
            <Border x:Name="ResizeBottomLeft" Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Tag="16"/>
            <Border x:Name="ResizeBottomRight" Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Tag="17"/>
        </Grid>
    </Border>
</Window>
