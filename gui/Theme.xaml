<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Northstar DevKit - brand theme.
        Palette extracted from the company logo (Futuristic Metallic Compass
        Rose): gunmetal/steel body on black, a glowing sapphire-blue core,
        and ember-orange accents. Loaded by DevKit-GUI.ps1 and
        DevKit-Widget.ps1 into Application.Resources before any window XAML
        is parsed (the Application is created first) - application scope is
        what lets the keyless styles reach template-generated scrollbars,
        popups, and dialog windows. No pack URIs, no compiled app.
    -->

    <!-- ==================== BRUSHES ==================== -->

    <SolidColorBrush x:Key="BrushWindowBg" Color="#0A0D12"/>
    <SolidColorBrush x:Key="BrushPanelBg" Color="#10151D"/>
    <SolidColorBrush x:Key="BrushNavBg" Color="#0C1017"/>
    <SolidColorBrush x:Key="BrushNavHover" Color="#151D29"/>
    <SolidColorBrush x:Key="BrushNavSelectedBg" Color="#16202E"/>
    <SolidColorBrush x:Key="BrushStatusBg" Color="#0B0F16"/>
    <SolidColorBrush x:Key="BrushSeparator" Color="#1D2634"/>
    <SolidColorBrush x:Key="BrushWindowBorder" Color="#232C3C"/>

    <SolidColorBrush x:Key="BrushTextBright" Color="#E9EEF6"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#96A1B3"/>
    <SolidColorBrush x:Key="BrushTextSteel" Color="#8E99AB"/>
    <SolidColorBrush x:Key="BrushTextDim" Color="#5D6878"/>

    <SolidColorBrush x:Key="BrushAccentBlue" Color="#4FA3FF"/>
    <SolidColorBrush x:Key="BrushAccentBlueGlow" Color="#79C0FF"/>
    <SolidColorBrush x:Key="BrushAccentEmber" Color="#FF6B3D"/>
    <SolidColorBrush x:Key="BrushAccentEmberDeep" Color="#D94F2B"/>
    <!-- Genuine red for destructive actions (node-kill button) - distinct from
         the amber BrushWarning/BrushGitTag and orange BrushAccentEmber, which
         both read as "caution", not "destructive". Tuned for contrast against
         BrushCardBg's #1A2230-#141B27 dark gradient. -->
    <SolidColorBrush x:Key="BrushDangerRed" Color="#F0454F"/>

    <SolidColorBrush x:Key="BrushInputBg" Color="#0D1219"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#2B3547"/>

    <SolidColorBrush x:Key="BrushScrollThumb" Color="#2B3547"/>
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#3A4657"/>

    <SolidColorBrush x:Key="BrushChipBg" Color="#1B2534"/>
    <SolidColorBrush x:Key="BrushCautionBg" Color="#2A1A12"/>

    <!-- Card body: subtle vertical gunmetal gradient, lighter on hover. -->
    <LinearGradientBrush x:Key="BrushCardBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A2230" Offset="0"/>
        <GradientStop Color="#141B27" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushCardBgHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E2735" Offset="0"/>
        <GradientStop Color="#161E2B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushCardBorder" Color="#2B3547"/>
    <SolidColorBrush x:Key="BrushCardBorderHover" Color="#4FA3FF"/>

    <!-- Sapphire run-button gradients. -->
    <LinearGradientBrush x:Key="BrushButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4FA3FF" Offset="0"/>
        <GradientStop Color="#2E7DD1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushButtonGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#79C0FF" Offset="0"/>
        <GradientStop Color="#3E8FE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushButtonGradientPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E7DD1" Offset="0"/>
        <GradientStop Color="#22619F" Offset="1"/>
    </LinearGradientBrush>

    <!-- The logo's duality: sapphire core to ember rim, used for accent strips. -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4FA3FF" Offset="0"/>
        <GradientStop Color="#FF6B3D" Offset="1"/>
    </LinearGradientBrush>
    <!-- Vertical variant of the same duality, for the widget's side-tab strip
         divider hairline (applied semi-transparent so it reads as a divider,
         not a bar). -->
    <LinearGradientBrush x:Key="BrushAccentGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4FA3FF" Offset="0"/>
        <GradientStop Color="#FF6B3D" Offset="1"/>
    </LinearGradientBrush>

    <!-- Brushed-silver title text. -->
    <LinearGradientBrush x:Key="BrushMetalGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F7FB" Offset="0"/>
        <GradientStop Color="#AAB4C4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== SEMANTIC TOKENS ==================== -->

    <!-- Status/feedback semantics: a bright fg accent plus a matching dark
         surface per state, a git-tag accent, and shared interaction-state
         fills (popup background, pressed states). Consumed by the styles
         below and by code-behind via FindResource. -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#3EDD8F"/>
    <SolidColorBrush x:Key="BrushSuccessSurface" Color="#12261E"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#FFB020"/>
    <SolidColorBrush x:Key="BrushWarningSurface" Color="#2A2110"/>
    <SolidColorBrush x:Key="BrushInfoSurface" Color="#122C3D"/>
    <SolidColorBrush x:Key="BrushEmberSurface" Color="#2A1A12"/>
    <SolidColorBrush x:Key="BrushGitTag" Color="#FFB020"/>
    <SolidColorBrush x:Key="BrushPopupBg" Color="#141B26"/>
    <SolidColorBrush x:Key="BrushPressedBg" Color="#232E42"/>
    <SolidColorBrush x:Key="BrushAccentEmberPressed" Color="#B03D20"/>

    <!-- ==================== FOCUS VISUAL ==================== -->

    <!-- One shared keyboard-focus ring for interactive controls - the
         default dotted rectangle clashes with the dark theme. Referenced
         via FocusVisualStyle on the button/nav/combobox styles below. -->
    <Style x:Key="DevKitFocusVisual"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource BrushAccentBlueGlow}" BorderThickness="1.5" CornerRadius="6" Margin="-3" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>

    <!-- ==================== WINDOW / TYPOGRAPHY ==================== -->

    <Style x:Key="RootWindow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushWindowBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushWindowBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- Kept small on purpose: this shadow sits on the LARGEST
                     element in the window, and on these AllowsTransparency
                     windows every pixel of blur radius is re-rasterized on
                     every recomposite. 28px read nicely but taxed the GPU
                     for the entire life of the window. -->
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="12" ShadowDepth="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushMetalGradient}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PageDescriptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSteel}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
