    <!-- ==================== TOOL CARDS ==================== -->

    <SolidColorBrush x:Key="ToolCardBorderBrush" Color="#2B3547"/>

    <Style x:Key="ToolCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,13,16,13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Instant brush swaps ONLY - no storyboards, no transform
                     animations. The old hover "lift" (Scale 1.01 + Translate
                     -1px + border color animation) re-rasterized every
                     bitmap-effect-bearing child (the gauge arcs used to carry
                     DropShadowEffects) on every animation frame, and on these
                     AllowsTransparency windows each of those frames forced a
                     full-window recomposite - hovering the gauges card
                     visibly spiked CPU and GPU. A static hover tint reads
                     almost the same and costs one recomposite. -->
                <Setter Property="Background" Value="{StaticResource BrushCardBgHover}"/>
                <Setter Property="BorderBrush" Value="#4FA3FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

