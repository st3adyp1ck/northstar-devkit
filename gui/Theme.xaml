                        <Grid>
                            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushAccentBlue}" CornerRadius="2"
                                    Margin="4,8,0,8" Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,8,10,8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource BrushNavHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextBright}"/>
